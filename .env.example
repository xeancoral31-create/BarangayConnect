# Copy to .env for local development and keep .env out of Git.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-for-local-development
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=
# For production, set DJANGO_DEBUG=False, a unique DJANGO_SECRET_KEY,
# exact DJANGO_ALLOWED_HOSTS, and HTTPS CSRF trusted origins.
